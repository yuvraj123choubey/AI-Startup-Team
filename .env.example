# AI Startup Team configuration.
# Copy this file to ".env" (same folder) and edit it. Never commit .env.
#
# Everything below except VITE_API_URL is read ONLY by the backend (server/).
# Vite exposes only variables that start with VITE_ to the browser, so the
# OpenAI key can never end up in the frontend bundle.

# "mock"   = simulated AI responses (default, no API key needed)
# "openai" = real OpenAI calls through the backend
AI_MODE=mock

# Your OpenAI API key (https://platform.openai.com/api-keys). Leave the placeholder for mock mode.
OPENAI_API_KEY=your_api_key_here

# Optional: model and request timeout
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=120000

# Port of the backend (Express)
PORT=3001

# Where the frontend finds the backend. If you remove this line, the Vite dev
# server proxies /api to http://localhost:3001 instead.
VITE_API_URL=http://localhost:3001

# ----- Only when the backend is hosted on the web (see render.yaml) -----
# HOSTED=true                      # previews served at /preview/<id>/ (Render sets RENDER=true automatically)
# ACCESS_CODE=choose-a-long-code   # required for Live AI and Build Project
# ALLOWED_ORIGINS=https://yuvraj123choubey.github.io
# PUBLIC_URL=https://your-backend.onrender.com   # Render provides RENDER_EXTERNAL_URL automatically
# MAX_PROJECTS=20
